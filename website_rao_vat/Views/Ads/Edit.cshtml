@model website_rao_vat.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa bài đăng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="category-card p-5 shadow-lg">
                <div class="d-flex align-items-center mb-4">
                    <a href="/User/Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h3 class="fw-bold mb-0">Chỉnh sửa tin đăng</h3>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />

                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label small text-secondary fw-bold">TIÊU ĐỀ TIN</label>
                            <input type="text" asp-for="Title" class="form-control bg-dark border-secondary border-opacity-25 text-white py-2" placeholder="Ví dụ: iPhone 15 Pro Max..." required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-secondary fw-bold">DANH MỤC</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select bg-dark border-secondary border-opacity-25 text-white py-2">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary fw-bold">GIÁ BÁN (VNĐ)</label>
                            <input type="number" asp-for="Price" class="form-control bg-dark border-secondary border-opacity-25 text-white py-2" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-secondary fw-bold">KHU VỰC / ĐỊA ĐIỂM</label>
                            <input type="text" asp-for="Location" class="form-control bg-dark border-secondary border-opacity-25 text-white py-2" placeholder="Quận 1, TP. HCM..." required>
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-secondary fw-bold">MÔ TẢ CHI TIẾT</label>
                            <textarea asp-for="Description" rows="6" class="form-control bg-dark border-secondary border-opacity-25 text-white py-2" placeholder="Mô tả tình trạng sản phẩm, phụ kiện kèm theo..."></textarea>
                        </div>

                        <div class="col-12 mt-5">
                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">Lưu thay đổi</button>
                                <a href="/User/Index" class="btn btn-outline-light px-4 py-2">Hủy bỏ</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>