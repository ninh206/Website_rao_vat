@model website_rao_vat.Models.AdPostViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài đăng";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-8">
        <div class="category-card p-5 border-0 shadow-sm rounded-4 bg-white">

            <div class="d-flex align-items-center mb-4">
                <a href="/User/Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold text-dark mb-0">Chỉnh sửa tin đăng</h2>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProductId" />

                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-bold small text-secondary">TIÊU ĐỀ TIN</label>
                        <input asp-for="Title" class="form-control rounded-3 border-light-subtle shadow-none"
                               placeholder="Ví dụ: iPhone 15 Pro Max..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold small text-secondary">DANH MỤC</label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryList"
                                class="form-select rounded-3 border-light-subtle shadow-none">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold small text-secondary">GIÁ BÁN (VNĐ)</label>
                        <input asp-for="Price" type="number" class="form-control rounded-3 border-light-subtle shadow-none" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Location" class="form-label fw-bold small text-secondary">KHU VỰC / ĐỊA ĐIỂM</label>
                        <input asp-for="Location" class="form-control rounded-3 border-light-subtle shadow-none"
                               placeholder="Quận 1, TP. HCM..." required />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold small text-secondary">MÔ TẢ CHI TIẾT</label>
                        <textarea asp-for="Description" rows="5" class="form-control rounded-3 border-light-subtle shadow-none"
                                  placeholder="Mô tả tình trạng sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold small text-secondary">HÌNH ẢNH MỚI (CHỌN ĐỂ THAY THẾ)</label>
                        <div class="upload-zone border-dashed p-4 text-center rounded-4 bg-light position-relative">
                            <input type="file" name="Images" id="file-input" multiple accept="image/*"
                                   class="form-control position-absolute opacity-0 w-100 h-100 top-0 start-0 cursor-pointer"
                                   style="z-index: 10;" />
                            <div id="upload-instruction">
                                <i class="bi bi-images fs-2 text-primary opacity-50"></i>
                                <p class="small text-muted mb-0">Bấm để chọn ảnh mới nếu muốn thay đổi hình ảnh hiện tại</p>
                            </div>
                            <div id="preview-container" class="d-flex flex-wrap gap-2 mt-3 justify-content-center"></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-5">
                    <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm flex-grow-1">
                        LƯU THAY ĐỔI
                    </button>
                    <a href="/User/Index" class="btn btn-light px-4 py-3 rounded-pill border shadow-sm text-dark fw-medium">
                        HỦY BỎ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>