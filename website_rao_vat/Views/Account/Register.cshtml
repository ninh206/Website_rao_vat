@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - RaoVatDonGian</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #0a0b0d;
            color: white;
            height: 100vh;
            display: flex;
            align-items: center;
        }

        .register-card {
            background: #1a1c1e;
            border: 1px solid #2d2f31;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
        }

        .form-control {
            background: #0a0b0d !important;
            border: 1px solid #343a40;
            color: white !important;
        }

        .btn-primary {
            background: #0d6efd;
            border: none;
            padding: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center">
        <div class="register-card shadow-lg">
            <h3 class="fw-bold mb-1">Tạo tài khoản mới</h3>
            <p class="text-secondary small mb-4">Tham gia cộng đồng rao vặt ngay hôm nay.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small border-0 mb-3" style="background: rgba(220, 53, 69, 0.1); color: #ea868f;">
                    <i class="bi bi-exclamation-circle me-2"></i> @ViewBag.Error
                </div>
            }

            <form action="/Account/Register" method="post">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Họ và tên</label>
                    <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="name@example.com" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small text-secondary">Mật khẩu</label>
                    <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-3">Đăng ký tài khoản</button>
            </form>

            <div class="text-center">
                <p class="text-secondary small">
                    Đã có tài khoản?
                    <a href="/Account/Login" class="text-primary text-decoration-none fw-bold">Quay lại Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>