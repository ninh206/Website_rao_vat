@model IEnumerable<website_rao_vat.Models.User>
@{
    ViewData["Title"] = "Quản trị hệ thống";
    var allPosts = ViewBag.AllPosts as List<website_rao_vat.Models.Product>;
}

<div class="mt-4">
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="category-card p-4 border-0 border-bottom border-primary border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold text-uppercase">Người dùng</small>
                        <h2 class="fw-bold mb-0 text-primary">@ViewBag.TotalUsers</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-3 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="category-card p-4 border-0 border-bottom border-success border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold text-uppercase">Tin đăng</small>
                        <h2 class="fw-bold mb-0 text-success">@ViewBag.TotalPosts</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-card-checklist fs-3 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="category-card p-4 mb-4 border-0 shadow-sm">
        <div class="row g-4">
            <div class="col-md-6 border-end border-light">
                <h6 class="text-dark fw-bold mb-3 small text-uppercase">Tìm kiếm người dùng</h6>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="userSearch" value="@Context.Request.Query["userSearch"]"
                           class="form-control shadow-none" placeholder="Tên hoặc Username...">
                    <button type="submit" class="btn btn-primary px-4">Tìm</button>
                </form>
            </div>
            <div class="col-md-6 ps-md-4">
                <h6 class="text-dark fw-bold mb-3 small text-uppercase">Tìm kiếm bài đăng</h6>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="postSearch" value="@Context.Request.Query["postSearch"]"
                           class="form-control shadow-none" placeholder="Tiêu đề bài viết...">
                    <button type="submit" class="btn btn-success px-4 text-white">Lọc tin</button>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="category-card p-4 h-100 border-0 shadow-sm">
                <h5 class="fw-bold mb-4"><i class="bi bi-people me-2 text-primary"></i>Người dùng</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Họ tên</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Sửa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">@user.Email</div>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-2">Online</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-25 rounded-pill px-2">Offline</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="/Admin/EditUser/@user.UserId" class="btn btn-sm btn-light border"><i class="bi bi-pencil-square"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="category-card p-4 h-100 border-0 shadow-sm d-flex flex-column">
                <h5 class="fw-bold mb-4"><i class="bi bi-card-list me-2 text-success"></i>Tin đăng gần đây</h5>
                <div class="table-responsive flex-grow-1">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Tin đăng</th>
                                <th>Giá</th>
                                <th class="text-end">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in allPosts)
                            {
                                <tr>
                                    <td>
                                        <div class="text-truncate fw-bold text-dark" style="max-width: 250px;">@post.Title</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">@post.CreatedAt?.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td class="text-primary fw-bold">@post.Price.ToString("N0")đ</td>
                                    <td class="text-end">
                                        <form asp-action="DeletePost" asp-route-id="@post.ProductId" method="post" onsubmit="return confirm('Xóa tin này?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <nav>
                            <ul class="pagination pagination-sm">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, postSearch = ViewBag.PostSearch, userSearch = ViewBag.UserSearch })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>