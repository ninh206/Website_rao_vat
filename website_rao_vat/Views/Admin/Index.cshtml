@model IEnumerable<website_rao_vat.Models.User>
@{
    ViewData["Title"] = "Bảng điều khiển quản trị";
    var allPosts = ViewBag.AllPosts as List<website_rao_vat.Models.Product>;
}

<div class="mt-4">
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="category-card p-4 border-start border-primary border-4 text-start shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary fw-bold text-uppercase">Người dùng</small>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
                    </div>
                    <i class="bi bi-people-fill fs-1 text-primary opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="category-card p-4 border-start border-success border-4 text-start shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary fw-bold text-uppercase">Tin đăng</small>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalPosts</h2>
                    </div>
                    <i class="bi bi-card-checklist fs-1 text-success opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="category-card p-4 mb-4 border-bottom border-primary border-3">
        <div class="row g-4">
            <div class="col-md-6 border-end border-secondary border-opacity-25">
                <h6 class="text-secondary fw-bold mb-3 small text-uppercase"><i class="bi bi-person-search me-2"></i>Tìm kiếm người dùng</h6>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text"
                           name="userSearch"
                           value="@Context.Request.Query["userSearch"]"
                           class="form-control bg-dark border-secondary text-white"
                           placeholder="Tìm theo tên hoặc tên đăng nhập...">

                    <button type="submit" class="btn btn-primary px-4">Tìm User</button>
                </form>
            </div>
            <div class="col-md-6 ps-md-4">
                <h6 class="text-secondary fw-bold mb-3 small text-uppercase"><i class="bi bi-search me-2"></i>Tìm kiếm bài đăng</h6>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="postSearch" value="@Context.Request.Query["postSearch"]"
                           class="form-control bg-dark border-secondary text-white" placeholder="Tiêu đề bài viết...">
                    <button type="submit" class="btn btn-success px-4 shadow-sm">Lọc tin</button>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 border-0 text-success mb-4 animate__animated animate__fadeIn">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="category-card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-4 text-start"><i class="bi bi-people me-2 text-primary"></i>Người dùng</h5>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle small">
                        <thead>
                            <tr class="text-secondary">
                                <th>Họ tên</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Sửa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@user.FullName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@user.Email</div>
                                        </td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="text-success" style="font-size: 0.75rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Online</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary" style="font-size: 0.75rem;"><i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i> Offline</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/Admin/EditUser/@user.UserId" class="btn btn-sm btn-outline-primary border-0"><i class="bi bi-pencil-square fs-5"></i></a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">Không tìm thấy người dùng</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="category-card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-4 text-start"><i class="bi bi-card-list me-2 text-success"></i>Tất cả tin đăng</h5>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle small">
                        <thead>
                            <tr class="text-secondary">
                                <th>Tin đăng</th>
                                <th>Giá</th>
                                <th class="text-end">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (allPosts != null && allPosts.Any())
                            {
                                @foreach (var post in allPosts)
                                {
                                    <tr>
                                        <td>
                                            <div class="text-truncate fw-bold" style="max-width: 200px;" title="@post.Title">@post.Title</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">Ngày đăng: @post.CreatedAt?.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td class="text-primary fw-bold">@post.Price.ToString("N0")đ</td>
                                        <td class="text-end">
                                            <form asp-action="DeletePost" asp-route-id="@post.ProductId" method="post" onsubmit="return confirm('Xác nhận xóa tin này?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash3 fs-5"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">Không có bài đăng nào</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>