@model website_rao_vat.Models.User
@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="category-card p-5 border-0 shadow">
            <h4 class="fw-bold mb-4 text-dark text-center">
                <i class="bi bi-person-circle text-primary me-2"></i>Hồ sơ người dùng
            </h4>

            <form asp-action="EditUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" value="@Model.UserId" />

                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">TÊN ĐĂNG NHẬP</label>
                    <input asp-for="Username" class="form-control py-2" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">HỌ VÀ TÊN</label>
                    <input asp-for="FullName" class="form-control py-2" />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">EMAIL</label>
                    <input asp-for="Email" class="form-control py-2" />
                </div>

                <div class="mb-4 p-3 bg-light rounded-3 border border-dashed border-primary border-opacity-25">
                    <label class="form-label small text-primary fw-bold">
                        <i class="bi bi-key-fill me-1"></i> CẤP MẬT KHẨU MỚI
                    </label>
                    <input type="text" name="newPassword" class="form-control" placeholder="Nhập pass mới nếu cần đổi...">
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-2 fw-bold">CẬP NHẬT THÔNG TIN</button>
                    <a href="/Admin/Index" class="btn btn-link text-secondary text-decoration-none">Quay lại trang quản lý</a>
                </div>
            </form>
        </div>
    </div>
</div>