@* Sửa lại Model cho đúng với class mình vừa tạo *@
@model IEnumerable<website_rao_vat.ViewComponents.CategoryWithCount>

<div class="row g-3">
    @foreach (var cat in Model)
    {
        <div class="col-6 col-md-3">
            <a href="/Home/Search?categoryId=@cat.CategoryId" class="text-decoration-none">
                <div class="bg-white p-3 rounded-4 border text-center category-item-hover">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2">
                        <i class="bi bi-tag text-primary fs-4"></i>
                    </div>
                    <div class="text-dark fw-bold small">@cat.CategoryName</div>

                    <div class="text-muted" style="font-size: 0.65rem;">
                        @cat.Count.ToString("N0") tin đăng
                    </div>
                </div>
            </a>
        </div>
    }
</div>