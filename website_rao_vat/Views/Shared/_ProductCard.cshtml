@model website_rao_vat.Models.ProductDisplayViewModel

<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card-hover bg-white">
    @* KHUNG ẢNH TỈ LỆ 4:3 CHUẨN - Click vào ảnh cũng ra chi tiết *@
    <div class="position-relative" style="padding-top: 75%; overflow: hidden; background: #f8f9fa;">
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId">
            <img src="@Model.ImageUrl"
                 class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover transition-all"
                 style="transition: 0.5s" alt="@Model.Title">
        </a>

        @* NÚT TIM: Không còn logic if/else, chỉ dùng class từ ViewModel *@
        <button class="btn btn-light btn-sm rounded-circle position-absolute btn-favorite shadow-sm"
                style="top: 12px; left: 12px; width: 34px; height: 34px; z-index: 5;"
                data-id="@Model.ProductId">
            <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary")"></i>
        </button>

        @if (Model.IsNew)
        {
            <span class="badge bg-primary position-absolute rounded-pill px-3" style="top: 12px; right: 12px; font-size: 0.7rem;">MỚI</span>
        }
    </div>

    @* NỘI DUNG CARD *@
    <div class="card-body p-3 d-flex flex-column">
        <div class="mb-1">
            <span class="text-primary fw-bold fs-5">@Model.Price.ToString("N0") đ</span>
        </div>

        <h6 class="text-dark fw-bold mb-2 text-truncate-2" style="height: 40px;" title="@Model.Title">
            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none text-dark">
                @Model.Title
            </a>
        </h6>

        <div class="d-flex align-items-center text-muted small mt-auto pt-2">
            <i class="bi bi-geo-alt me-1"></i>
            <span class="text-truncate">@Model.Location</span>
            <span class="mx-2 opacity-25">|</span>
            <span>@Model.TimeAgo</span>
        </div>

        @* NÚT XEM THÔNG TIN (Thay thế cho Giỏ hàng) *@
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId"
               class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold py-2">
                <i class="bi bi-eye me-1"></i> Xem thông tin
            </a>
        </div>
    </div>
</div>

<style>
    /* Hiệu ứng di chuột "Premium" */
    .product-card-hover {
        transition: all 0.3s ease;
        border: 1px solid transparent !important;
    }

        .product-card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08) !important;
            border-color: rgba(13, 110, 253, 0.1) !important;
        }

            .product-card-hover:hover img {
                transform: scale(1.08);
            }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>