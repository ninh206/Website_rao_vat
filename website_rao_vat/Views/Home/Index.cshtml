@model IEnumerable<website_rao_vat.Models.ProductDisplayViewModel>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Trang chủ - Classifieds";
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
}

<style>
    /* Hero Section kiểu mới - Sáng và hiện đại */
    .hero-light {
        background: linear-gradient(135.44deg, #e0eafc 0%, #cfdef3 100%);
        padding: 80px 0;
        border-radius: 0 0 50px 50px;
        margin-bottom: 50px;
    }

    .search-box-client {
        background: #ffffff;
        padding: 15px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        max-width: 800px;
        margin: 0 auto;
    }

    .section-title {
        position: relative;
        padding-bottom: 10px;
    }

        .section-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 45px;
            height: 4px;
            background: #0d6efd;
            border-radius: 10px;
        }
</style>

@* 1. PHẦN HERO SECTION (BANNER SÁNG) *@
<section class="hero-light text-center">
    <div class="container">
        <h1 class="display-5 fw-bold text-dark mb-3">Tìm mọi thứ bạn cần tại địa phương</h1>
        <p class="text-secondary mb-5 fs-5">Tham gia cộng đồng mua bán rao vặt an toàn, tin cậy.</p>

        @* Thanh tìm kiếm to ở giữa trang chủ *@
        <form class="search-box-client d-flex gap-2" asp-controller="Home" asp-action="Search" method="get">
            <div class="input-group flex-grow-1">
                <span class="input-group-text bg-white border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="query" class="form-control border-0 shadow-none" placeholder="Bạn đang tìm kiếm món đồ gì?">
            </div>
            <button type="submit" class="btn btn-primary px-4 fw-bold rounded-3">TÌM KIẾM</button>
        </form>
    </div>
</section>

<div class="container">
    @* 2. PHẦN DANH MỤC (GỌI VIEWCOMPONENT) *@
    <div class="mb-5">
        <h4 class="fw-bold text-dark section-title mb-4">Danh mục phổ biến</h4>
        @await Component.InvokeAsync("CategoryMenu")
    </div>

    @* 3. DANH SÁCH TIN ĐĂNG (GỌI PARTIAL VIEW) *@
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h4 class="fw-bold text-dark section-title mb-0">Tin đăng mới nhất</h4>
            </div>
            <a href="@Url.Action("Search", "Home")" class="btn btn-link text-primary text-decoration-none fw-bold p-0">
                Xem tất cả <i class="bi bi-chevron-right small"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @* Sử dụng Partial View để hiển thị từng Card sản phẩm *@
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-5 rounded-4 shadow-sm border border-dashed">
                        <i class="bi bi-inbox text-muted display-4"></i>
                        <p class="text-muted mt-3">Hiện tại chưa có tin đăng nào mới.</p>
                        <a asp-controller="Ads" asp-action="Post" class="btn btn-primary btn-sm mt-2">Đăng tin ngay</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).on("click", ".btn-favorite, .btn-add-cart", function (e) {
            e.preventDefault();
            
            // Check Session từ C# đẩy ra JS
            var userId = '@Context.Session.GetString("UserId")';

            // Nếu chưa đăng nhập thì "đá" ra trang Login
            if (!userId || userId === '') {
                alert("Ninh nhắc: Ông phải đăng nhập mới dùng được cái này!");
                window.location.href = "/Account/Login";
                return;
            }

            var btn = $(this);
            var pId = btn.data("id");

            // Xử lý Thả tim
            if (btn.hasClass("btn-favorite")) {
                $.post("/Ads/ToggleFavorite", { productId: pId }, function (data) {
                    if (data.success) {
                        var icon = btn.find("i");
                        if (data.isFavorite) {
                            icon.removeClass("bi-heart text-secondary").addClass("bi-heart-fill text-danger");
                        } else {
                            icon.removeClass("bi-heart-fill text-danger").addClass("bi-heart text-secondary");
                        }
                    }
                });
            }

            // Xử lý Giỏ hàng (Ông viết thêm Controller Cart tương tự nhé)
            if (btn.hasClass("btn-add-cart")) {
                alert("Đã thêm vào giỏ hàng! (Ninh viết tiếp Logic ở CartController nhé)");
            }
        });
    </script>
}