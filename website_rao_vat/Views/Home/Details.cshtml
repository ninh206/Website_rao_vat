@model website_rao_vat.Models.Product

@{
    ViewData["Title"] = Model.Title;

}

<style>
    .product-img-main {
        width: 100%;
        height: 500px;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid var(--border-color);
    }

    .seller-card {
        background: var(--card-dark);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 20px;
        position: sticky;
        top: 100px;
    }

    .price-tag {
        font-size: 2rem;
        color: var(--primary-blue);
        font-weight: 800;
    }
</style>

<div class="container mt-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-secondary text-decoration-none">@Model.Category?.CategoryName</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="mb-4">
                <img src="@(Model.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
                     class="product-img-main shadow" id="mainImg">
            </div>

            <div class="d-flex gap-2 mb-4 overflow-auto pb-2">
                @foreach (var img in Model.ProductImages)
                {
                    <img src="@img.ImageUrl" class="rounded border"
                         style="width: 80px; height: 80px; cursor: pointer; object-fit: cover;"
                         onclick="document.getElementById('mainImg').src='@img.ImageUrl'">
                }
            </div>

            <hr class="border-secondary opacity-25">

            <div class="mt-4">
                <h2 class="fw-bold mb-3">@Model.Title</h2>
                <div class="d-flex gap-4 text-secondary mb-4">
                    <span><i class="bi bi-geo-alt me-1"></i> @Model.Location</span>
                    <span><i class="bi bi-clock me-1"></i> @Model.CreatedAt?.ToString("dd/MM/yyyy")</span>
                    <span><i class="bi bi-eye me-1"></i> @(Model.ViewCount ?? 0) lượt xem</span>
                </div>

                <h5 class="fw-bold text-black mb-3">Mô tả chi tiết</h5>
                <div class="text-secondary lh-lg" style="white-space: pre-line;">
                    @Model.Description
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="seller-card shadow-sm">
                <div class="price-tag mb-4">@string.Format("{0:N0}", Model.Price) đ</div>

                <div class="d-flex align-items-center mb-4 p-3 border border-secondary border-opacity-25 rounded-3">
                    <div class="flex-shrink-0">
                        <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 fw-bold">@Model.User?.FullName</h6>
                        <small class="text-success"><i class="bi bi-patch-check-fill"></i> Đã xác minh</small>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="tel:@Model.User?.PhoneNumber" class="btn btn-primary btn-lg fw-bold py-3">
                        <i class="bi bi-telephone-fill me-2"></i> @Model.User?.PhoneNumber
                    </a>
                    <button class="btn btn-outline-dark btn-lg py-3">
                        <i class="bi bi-chat-dots me-2"></i> Nhắn tin người bán
                    </button>
                    <button class="btn btn-link text-secondary text-decoration-none mt-2">
                        <i class="bi bi-heart me-1"></i> Lưu tin đăng này
                    </button>
                </div>

                <div class="mt-4 p-3 bg-dark rounded-3 small text-secondary">
                    <i class="bi bi-shield-lock-fill text-warning me-2"></i>
                    Đừng bao giờ chuyển khoản trước. Hãy kiểm tra hàng kỹ lưỡng trước khi mua.
                </div>
            </div>
        </div>
    </div>
</div>