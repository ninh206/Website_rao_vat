@model List<website_rao_vat.Models.ProductDisplayViewModel>
<style>
    /* Thêm hiệu ứng di chuột cho nó chuyên nghiệp */
    .product-card {
        transition: transform 0.2s ease, shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>
<div class="container mt-4">
    <h4 class="mb-4">Kết quả tìm kiếm cho: <span class="text-primary">"@ViewBag.Keyword"</span></h4>
    <hr>

    @if (!Model.Any())
    {
            <div class="text-center py-5">
                <i class="bi bi-search text-secondary fs-1"></i>
                <p class="mt-3 text-muted">Rất tiếc, không tìm thấy bài đăng nào khớp với từ khóa của bạn.</p>
                <a href="/" class="btn btn-outline-primary">Quay lại trang chủ</a>
            </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <a href="/Home/Details/@item.ProductId" class="text-decoration-none">
                        <div class="card h-100 border-0 shadow-sm rounded-3 product-card">
                            <div class="position-relative">
                                <img src="@item.ImageUrl" class="card-img-top object-fit-cover" style="height: 150px;">
                                @if (item.IsNew)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Mới</span>
                                }
                            </div>
                            <div class="card-body p-2">
                                <h6 class="card-title text-truncate mb-1 text-dark fw-bold">@item.Title</h6>
                                <p class="text-primary fw-bold mb-0">@item.Price.ToString("N0") đ</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted" style="font-size: 0.7rem;">@item.Location</small>
                                    <small class="text-muted" style="font-size: 0.7rem;">@item.TimeAgo</small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>