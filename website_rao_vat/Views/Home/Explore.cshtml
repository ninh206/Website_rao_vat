@model IEnumerable<website_rao_vat.Models.Category>
@{
    ViewData["Title"] = "Khám phá danh mục";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Khám phá mọi thứ</h2>
        <p class="text-muted">Duyệt qua các danh mục phổ biến nhất của chúng tôi</p>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <a href="@Url.Action("Search", "Home", new { categoryId = item.CategoryId })" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 chat-item-hover">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-tag-fill fs-3"></i>
                        </div>
                        <h6 class="fw-bold text-dark">@item.CategoryName</h6>
                        <small class="text-muted">Bấm để khám phá ngay</small>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .chat-item-hover {
        transition: 0.3s;
    }

        .chat-item-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>